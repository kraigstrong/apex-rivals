<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the race run at up to 120 frames a second on ProMotion iPhones, as its SpriteView asks. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Race a friend: Game Center asks before sharing the player's friends list. -->
	<key>NSGKFriendListUsageDescription</key>
	<string>Shows which of your Game Center friends have raced each circuit, so you can race their best laps.</string>
</dict>
</plist>
